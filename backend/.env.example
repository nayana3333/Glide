# Copy to .env and adjust for your environment.
# Left unset, DATABASE_URL defaults to a local SQLite file (backend/glide.db) — zero setup for dev.
# Point it at Postgres for staging/production, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/glide
DATABASE_URL=

SECRET_KEY=change-me-to-a-random-string-in-production
