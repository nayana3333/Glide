# Normalize line endings to LF in the repository regardless of what OS
# checks a file out or in - avoids the diff noise and cross-platform
# inconsistency that comes from a mixed-line-ending history.
* text=auto eol=lf

# Binary files: never touch line endings, never diff as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.docx binary
*.db binary
